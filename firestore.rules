rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'] ||
         request.auth.token.email == "arvin8786@gmail.com");
    }

    function isManagerOrAbove() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner', 'manager'] ||
         request.auth.token.email == "arvin8786@gmail.com");
    }

    function isStorekeeper() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'storekeeper';
    }

    function hasRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isValidString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function isValidNumber(val, min) {
      return val is number && val >= min;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && 
        request.resource.data.keys().hasAll(['uid', 'email', 'role']) &&
        request.resource.data.role in ['admin', 'storekeeper', 'requester', 'hr_manager', 'employee', 'sales', 'cashier', 'manager', 'owner'];
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || 
        isAdmin() || 
        hasRole('hr_manager') || 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == 'HR');
      allow delete: if isAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole('hr_manager') || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == 'HR');
    }

    // Leave Requests
    match /leaveRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdmin() || 
        hasRole('hr_manager') || 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == 'HR') ||
        (isAuthenticated() && resource.data.superiorId == request.auth.uid) ||
        (isAuthenticated() && resource.data.employeeId == request.auth.uid && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Appraisals
    match /appraisals/{appraisalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole('hr_manager') || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == 'HR');
    }

    // Payroll
    match /payroll/{payrollId} {
      allow read: if isAuthenticated() && (isAdmin() || hasRole('hr_manager') || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == 'HR') || resource.data.employeeId == request.auth.uid);
      allow create, update, delete: if isAdmin() || hasRole('hr_manager') || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.department == 'HR');
    }

    // Sales Orders
    match /salesOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Customers
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // POS Sales Transactions
    match /salesTransactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Customer Memberships
    match /memberships/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Timed Markdown Rules
    match /markdownRules/{ruleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole('storekeeper') || hasRole('sales');
    }

    // Items collection (Inventory)
    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isStorekeeper() || isManagerOrAbove();
      allow update: if isAuthenticated(); // Allows stock adjustments, transaction updates, and sales
      allow delete: if isAdmin();
    }

    // Purchase Requests
    match /purchaseRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isManagerOrAbove() || (isAuthenticated() && resource.data.requesterId == request.auth.uid && resource.data.status == 'pending');
      allow delete: if isAdmin() || isManagerOrAbove();
    }

    // Purchase Orders (authorized by Manager or Owner, or auto-approved)
    match /purchaseOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAbove() || isAuthenticated();
      allow delete: if isAdmin();
    }

    // PO Amendment Requests
    match /poAmendRequests/{reqId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Inventory Cycle Counting
    match /cycleCounts/{countId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || isManagerOrAbove();
    }

    // Vendor Orders (routed automatically or managed by Procurement/Store)
    match /vendorOrders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAbove() || isStorekeeper();
      allow delete: if isAdmin();
    }

    // Goods Receipts
    match /goodsReceipts/{receiptId} {
      allow read: if isAuthenticated();
      allow create: if isStorekeeper() || isManagerOrAbove();
      allow update: if isStorekeeper() || isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // Goods Issuances
    match /goodsIssuances/{issuanceId} {
      allow read: if isAuthenticated();
      allow create: if isStorekeeper() || isManagerOrAbove();
      allow update: if isStorekeeper() || isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // Business Settings & Document Branding
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // Confidential Workplace Feedback (strictly Director/Owner read-only)
    match /workplaceFeedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isManagerOrAbove();
      allow update, delete: if isAdmin();
    }

    // Attendance & Geofenced Clock Logs
    match /clockLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if hasRole('hr_manager') || isManagerOrAbove() || isAdmin();
      allow delete: if isAdmin();
    }

    // Shift Rosters
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasRole('hr_manager') || isManagerOrAbove() || isAdmin();
    }

    // Claims Management & Expense OCR
    match /expenseClaims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if hasRole('hr_manager') || isManagerOrAbove() || isAdmin() || (isAuthenticated() && resource.data.employeeId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // General Ledger & Journal Vouchers
    match /ledgerJournals/{journalId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Accounts Payable (AP) & Accounts Receivable (AR)
    match /apInvoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAbove() || isStorekeeper() || isAdmin();
      allow delete: if isAdmin();
    }

    match /arInvoices/{invoiceId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAbove() || hasRole('sales') || isAdmin();
      allow delete: if isAdmin();
    }

    // Parked POS Carts & Tabs
    match /parkedCarts/{cartId} {
      allow read, write: if isAuthenticated();
    }

    // Vendors Master
    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      allow create, update: if isStorekeeper() || isManagerOrAbove() || isAdmin();
      allow delete: if isAdmin();
    }

    // Departments Master
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow create, update: if isManagerOrAbove() || isAdmin();
      allow delete: if isAdmin();
    }

    // Health check test connection
    match /test/{docId} {
      allow read: if true;
    }
  }
}
